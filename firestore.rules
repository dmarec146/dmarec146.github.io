// Règles de sécurité Firestore — projet Firebase "cahiers-interactifs".
//
// Ce fichier n'est PAS déployé automatiquement : il n'existe pas encore de
// Firebase CLI configurée sur ce dépôt. Pour l'appliquer, copier-coller son
// contenu dans Console Firebase → Firestore Database → Règles → Publier.
//
// Modèle de données :
//   eleves/{uid}                    profil d'un élève (pseudo, classe...)
//   eleves/{uid}/tentatives/{id}     une tentative sur un exercice (journal, non modifiable)
//                                    -- ancien modèle de suivi des cahiers de calcul,
//                                       encore utilisé par les fiches pas migrées
//   eleves/{uid}/connexions/{id}     une connexion reussie (journal, non modifiable)
//   eleves/{uid}/automatismes/{id}   un sujet blanc termine (journal, non modifiable)
//   eleves/{uid}/brouillons/{ficheId} état courant d'une fiche de calcul en pause
//                                    -- nouveau modèle, mutable, écrasé/supprimé par l'élève
//   eleves/{uid}/brouillonsAutomatismes/{devoirId} état courant d'une série
//                                    d'automatismes en devoir mode fiche, même principe
//                                    que brouillons/{ficheId} mais indexé par devoirId
//   eleves/{uid}/resultats/{ficheId}  score cumulé d'une fiche de calcul (nouveau modèle)
//   eleves/{uid}/devoirsTentatives/{id} une tentative sur un devoir précis (journal, non
//                                    modifiable) -- score individuel de CETTE validation,
//                                    séparé de resultats/{ficheId} qui fusionne tous les
//                                    passages ; nécessaire pour retrouver la meilleure
//                                    tentative complète d'un devoir
//   eleves/{uid}/devoirsMasques/{devoirId} devoir "fait" que l'élève a retiré de sa liste
//                                    (/mes-devoirs/) -- simple masquage : le devoir, les
//                                    tentatives et les résultats de l'enseignant ne bougent pas
//   devoirs/{id}                    un devoir attribué par l'enseignant
//   statistiques/{AAAA-MM-JJ}_{n}   compteurs anonymes de fréquentation d'un jour
//                                    (fragment n de 0 à 4) -- écrits par tout visiteur,
//                                    connecté ou non, uniquement par ajout (1 page vue, ou un
//                                    paquet de 12 au plus : assets/js/statistiques.js) ; lus par l'admin
//                                    (tableau-de-bord/frequentation.html)
//
// Les comptes élèves et les comptes enseignants sont créés côté serveur (script
// outils/creer-comptes, SDK Admin, qui ignore ces règles). Les droits sont des
// custom claims posés par ce même script — pas des UID codés en dur, pour ne pas
// casser les règles si un compte est recréé :
//   admin       David : fréquentation du site (statistiques) uniquement. Depuis le
//               27/10/2026 ce droit ne donne AUCUN accès, depuis le site, aux élèves
//               ni aux devoirs des enseignants (les siens, il les a par « enseignant »).
//               Les scripts et la console Firebase (SDK Admin) ignorent ces règles :
//               c'est la seule porte vers les données des collègues, volontaire.
//   enseignant  un enseignant (invité) : ne voit et ne gère que SES élèves et
//               SES devoirs. David a les deux claims.
// Propriété (multi-enseignants, 26/10/2026) : le champ « enseignant » (uid de
// l'enseignant) figure sur eleves/{uid} et sur devoirs/{id}. Un enseignant doit
// donc toujours interroger avec where('enseignant', '==', son uid) : Firestore
// refuse une requête que les règles ne peuvent pas garantir.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    function estEnseignant() {
      return request.auth != null && request.auth.token.get('enseignant', false) == true;
    }

    function estProprietaire(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // L'enseignant propriétaire de l'élève {uid} (lecture du profil : un seul
    // get(), mis en cache pour toute la requête).
    function estSonEnseignant(uid) {
      return estEnseignant()
        && get(/databases/$(database)/documents/eleves/$(uid)).data.enseignant == request.auth.uid;
    }

    function accesEleve(uid) {
      return estProprietaire(uid) || estSonEnseignant(uid);
    }

    match /eleves/{uid} {
      // Profil : l'élève lit le sien, un enseignant lit les profils de SES élèves
      // seulement. Aucune écriture depuis le site : les comptes sont créés et
      // modifiés par les scripts (SDK Admin, qui contourne ces règles).
      allow read: if estProprietaire(uid)
        || (estEnseignant() && resource.data.enseignant == request.auth.uid);
      allow write: if false;

      match /tentatives/{tentativeId} {
        // Journal d'usage : l'élève ajoute ses propres tentatives, personne
        // ne les modifie une fois écrites (y compris l'enseignant) ; seule
        // une suppression par l'enseignant est permise, pour corriger un cas.
        allow read: if accesEleve(uid);
        allow create: if estProprietaire(uid);
        allow update: if false;
        allow delete: if estSonEnseignant(uid);
      }

      match /connexions/{connexionId} {
        // Meme principe que tentatives : un journal d'evenements, pas un
        // etat -- l'eleve ajoute, personne ne modifie, seul l'enseignant
        // peut supprimer une entree.
        allow read: if accesEleve(uid);
        allow create: if estProprietaire(uid);
        allow update: if false;
        allow delete: if estSonEnseignant(uid);
      }

      match /automatismes/{automatismeId} {
        // Meme principe que tentatives/connexions : un sujet blanc termine,
        // journal non modifiable.
        allow read: if accesEleve(uid);
        allow create: if estProprietaire(uid);
        allow update: if false;
        allow delete: if estSonEnseignant(uid);
      }

      match /brouillons/{ficheId} {
        // Etat courant d'une fiche de calcul en pause (pas un journal) :
        // l'eleve peut l'ecraser ou le supprimer librement, contrairement
        // aux collections ci-dessus. Uniquement les cahiers de calcul.
        allow read: if accesEleve(uid);
        allow create, update, delete: if estProprietaire(uid);
      }

      match /brouillonsAutomatismes/{devoirId} {
        // Meme principe que brouillons/{ficheId} ci-dessus (etat courant en
        // pause, pas un journal) : l'eleve peut l'ecraser ou le supprimer
        // librement. Uniquement les series d'automatismes en devoir mode
        // fiche (jamais le mode chrono, joue d'une traite).
        allow read: if accesEleve(uid);
        allow create, update, delete: if estProprietaire(uid);
      }

      match /resultats/{ficheId} {
        // Score cumule par fiche de calcul (remplace le journal
        // "tentatives" pour les fiches migrees vers ce nouveau modele) : mis
        // a jour (merge) a chaque validation. Pas de suppression par
        // l'eleve, comme les journaux ci-dessus.
        allow read: if accesEleve(uid);
        allow create, update: if estProprietaire(uid);
        allow delete: if estSonEnseignant(uid);
      }

      match /devoirsTentatives/{tentativeId} {
        // Meme principe que tentatives/connexions/automatismes : un
        // journal d'evenements (une tentative sur un devoir precis), pas un
        // etat -- l'eleve ajoute, personne ne modifie, seul l'enseignant
        // peut supprimer une entree.
        allow read: if accesEleve(uid);
        allow create: if estProprietaire(uid);
        allow update: if false;
        allow delete: if estSonEnseignant(uid);
      }

      match /devoirsMasques/{devoirId} {
        // L'élève retire un devoir fait de SA liste (04/10/2026) : il crée
        // un marqueur (rien d'autre que la date) et peut le supprimer ;
        // ni le devoir (écriture enseignant), ni ses tentatives (suppression
        // enseignant) ne sont touchés, l'enseignant garde tous les résultats.
        allow read: if accesEleve(uid);
        allow create: if estProprietaire(uid)
          && request.resource.data.keys().hasOnly(['masqueLe'])
          && request.resource.data.masqueLe == request.time;
        allow update: if false;
        allow delete: if estProprietaire(uid) || estSonEnseignant(uid);
      }
    }

    match /devoirs/{devoirId} {
      // Lecture (resserrée le 27/10/2026) : l'enseignant propriétaire, et les élèves
      // DE CET enseignant (champ enseignant de leur profil, un seul get()). Les
      // pages filtrent déjà par enseignant (where), ce que Firestore exige pour
      // accepter une requête de liste. Ni un élève d'un autre enseignant, ni un
      // compte sans profil, ni l'administrateur seul ne lisent les devoirs.
      allow read: if estEnseignant() && resource.data.enseignant == request.auth.uid
        || request.auth != null
          && resource.data.enseignant == get(/databases/$(database)/documents/eleves/$(request.auth.uid)).data.enseignant;
      // Écriture : un enseignant seulement pour SES devoirs (champ enseignant =
      // son uid, à la création comme ensuite). Le droit admin n'y change rien.
      allow create: if estEnseignant() && request.resource.data.enseignant == request.auth.uid;
      allow update: if estEnseignant() && resource.data.enseignant == request.auth.uid
        && request.resource.data.enseignant == request.auth.uid;
      allow delete: if estEnseignant() && resource.data.enseignant == request.auth.uid;
    }

    // ---------- Fréquentation anonyme (03/10/2026 ; écritures groupées 28/10/2026) ----------
    // N'importe quel visiteur (même non connecté) peut seulement AUGMENTER des
    // compteurs connus ; personne d'autre que l'enseignant ne lit. Une écriture
    // porte une page vue (la première d'une visite) ou un paquet de 12 pages vues
    // au plus (assets/js/statistiques.js regroupe les suivantes dans le navigateur
    // pour limiter le nombre d'écritures) : pv de +1 à +12, chaque partie s_* de
    // +0 à +12, au plus 12 pages touchées dans « pages », et visites, visiteurs,
    // appareil a_* de +1 au plus. Aucune baisse ni suppression de page. Toute
    // autre clé ou tout autre identifiant de document est refusé. Limite
    // assumée : les règles ne savent pas parcourir « pages », donc la valeur
    // ajoutée à chaque page n'est pas bornée individuellement (la somme n'est
    // pas non plus rapprochée de pv) -- gonfler ou fausser ces chiffres reste
    // possible, rien d'autre. Ancien format (une page, pv +1, derniere) toujours accepté.
    function clesStatistiques() {
      return ['pv', 'visites', 'visiteurs',
              's_accueil', 's_cahiers', 's_fiches_seconde', 's_fiches_premiere', 's_fiches_terminale',
              's_automatismes', 's_qcm_bac', 's_mes_devoirs', 's_connexion', 's_autres',
              'a_ordinateur', 'a_tablette', 'a_telephone',
              'pages', 'derniere'];
    }
    // Création : compteur absent ou compris entre 1 et 12 / absent ou égal à 1.
    function paquetOuAbsent(d, cle) {
      return !(cle in d) || (d[cle] is int && d[cle] >= 1 && d[cle] <= 12);
    }
    function unOuAbsent(d, cle) {
      return !(cle in d) || d[cle] == 1;
    }
    // Mise à jour : compteur inchangé ou augmenté de 1 exactement / de 12 au plus.
    function memeOuPlusUn(d, a, cle) {
      return d.get(cle, 0) == a.get(cle, 0) || d.get(cle, 0) == a.get(cle, 0) + 1;
    }
    function hausseBornee(d, a, cle) {
      return d.get(cle, 0) >= a.get(cle, 0) && d.get(cle, 0) <= a.get(cle, 0) + 12;
    }
    function derniereValide(d) {
      return !('derniere' in d) || (d.derniere is string && d.derniere.matches('^[a-z0-9-]{1,40}$'));
    }
    function creationStatistiquesValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(clesStatistiques())
        && d.keys().hasAll(['pv', 'pages'])
        && derniereValide(d)
        && d.pv is int && d.pv >= 1 && d.pv <= 12
        && d.pages is map && d.pages.size() >= 1 && d.pages.size() <= 12
        && unOuAbsent(d, 'visites') && unOuAbsent(d, 'visiteurs')
        && paquetOuAbsent(d, 's_accueil') && paquetOuAbsent(d, 's_cahiers') && paquetOuAbsent(d, 's_fiches_seconde')
        && paquetOuAbsent(d, 's_fiches_premiere') && paquetOuAbsent(d, 's_fiches_terminale') && paquetOuAbsent(d, 's_automatismes') && paquetOuAbsent(d, 's_qcm_bac')
        && paquetOuAbsent(d, 's_mes_devoirs') && paquetOuAbsent(d, 's_connexion') && paquetOuAbsent(d, 's_autres')
        && unOuAbsent(d, 'a_ordinateur') && unOuAbsent(d, 'a_tablette') && unOuAbsent(d, 'a_telephone');
    }
    function miseAJourStatistiquesValide() {
      let d = request.resource.data;
      let a = resource.data;
      return d.keys().hasOnly(clesStatistiques())
        && derniereValide(d)
        && d.pv is int && d.pv >= a.pv + 1 && d.pv <= a.pv + 12
        && d.pages is map && d.pages.size() <= 250
        && d.pages.diff(a.pages).removedKeys().size() == 0
        && d.pages.diff(a.pages).affectedKeys().size() <= 12
        && memeOuPlusUn(d, a, 'visites') && memeOuPlusUn(d, a, 'visiteurs')
        && hausseBornee(d, a, 's_accueil') && hausseBornee(d, a, 's_cahiers') && hausseBornee(d, a, 's_fiches_seconde')
        && hausseBornee(d, a, 's_fiches_premiere') && hausseBornee(d, a, 's_fiches_terminale') && hausseBornee(d, a, 's_automatismes') && hausseBornee(d, a, 's_qcm_bac')
        && hausseBornee(d, a, 's_mes_devoirs') && hausseBornee(d, a, 's_connexion') && hausseBornee(d, a, 's_autres')
        && memeOuPlusUn(d, a, 'a_ordinateur') && memeOuPlusUn(d, a, 'a_tablette') && memeOuPlusUn(d, a, 'a_telephone');
    }

    match /statistiques/{jour} {
      allow read: if estAdmin();
      allow create: if jour.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-4]$') && creationStatistiquesValide();
      allow update: if jour.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-4]$') && miseAJourStatistiquesValide();
      allow delete: if estAdmin();
    }
  }
}
