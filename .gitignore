outils/creer-comptes/node_modules/
outils/creer-comptes/service-account.json
outils/creer-comptes/comptes-crees-*.csv
outils/creer-comptes/import-*.csv

# Outil d'étiquettes (outils/etiquettes) : PDF contenant des mots de passe.
outils/etiquettes/node_modules/
outils/etiquettes/etiquettes-*.pdf

# Scripts de travail ponctuels des sessions Claude Code (deja appliques, a ne
# pas relancer) : restent locaux a chaque machine.
.claude/scratch/

# Guide de l'eleve (outils/guide-eleve) : bibliotheques installees pour les captures.
outils/guide-eleve/node_modules/

# Test des regles Firestore (outils/verification/regles-firestore) : outils installes localement.
outils/verification/regles-firestore/node_modules/
outils/verification/regles-firestore/package*.json
outils/verification/regles-firestore/*.log
